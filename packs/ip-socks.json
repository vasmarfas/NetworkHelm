{
    "$schema": "./pack.schema.json",
    "menu": ["IP", "Socks"],
    "window": {
        "title": "Socks Settings",
        "tabs": [
            { "title": "Socks Settings", "path": "ip/socks" }
        ]
    },
    "paths": {
        "ip/socks": {
            "form": "settings",
            "links": [
                { "title": "Access", "path": "ip/socks/access" },
                { "title": "Connections", "path": "ip/socks/connections" },
                { "title": "Users", "path": "ip/socks/users" }
            ]
        }
    },
    "forms": {
        "settings": {
            "title": "Socks Settings",
            "tabs": [
                {
                    "title": "General",
                    "fields": ["enabled", "port", "connection-idle-timeout", "max-connections", "vrf", "version", "auth-method"]
                }
            ]
        }
    },
    "labels": {
        "auth-method": "Authentication Method"
    }
}
