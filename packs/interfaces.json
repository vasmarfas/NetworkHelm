                    ]
                },
                { "title": "Loop Protect", "fields": ["loop-protect", "loop-protect-disable-time", "loop-protect-send-interval"] },
                {
                    "title": "Status",
                    "readonly": true,
                    "path": "interface",
                    "fields": [
                        "last-link-down-time", "last-link-up-time", "link-downs", "-",
                        "status", "auto-negotiation", "rate", "full-duplex", "tx-flow-control", "rx-flow-control", "-",
                        "advertising", "link-partner-advertising"
