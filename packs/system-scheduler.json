{
    "$schema": "./pack.schema.json",
    "menu": ["System", "Scheduler"],
    "window": {
        "title": "Scheduler",
        "tabs": [
            { "title": "Scheduler", "path": "system/scheduler" }
        ]
    },
    "paths": {
        "system/scheduler": {
            "columns": ["name", "start-date", "start-time", "days", "interval", "owner", "run-count", "next-run", "on-event"],
