    "forms": {
        "schedule": {
            "title": "Schedule <{name}>",
            "tabs": [
                {
                    "title": "General",
                    "fields": ["name", "start-date", "start-time", "days", "interval", "-", "owner", "policy", "-", "run-count", "next-run", "-", "on-event"]
                }
            ]
        }
    }
}
