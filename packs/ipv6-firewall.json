{
    "$schema": "./pack.schema.json",
    "menu": ["IPv6", "Firewall"],
    "window": {
        "title": "IPv6 Firewall",
        "tabs": [
            { "title": "Filter Rules", "path": "ipv6/firewall/filter" },
            { "title": "NAT", "path": "ipv6/firewall/nat", "since": "7.0" },
            { "title": "Mangle", "path": "ipv6/firewall/mangle" },
            { "title": "Raw", "path": "ipv6/firewall/raw" },
            { "title": "Connections", "path": "ipv6/firewall/connection" },
            { "title": "Address Lists", "path": "ipv6/firewall/address-list" }
        ]
    },
    "paths": {
        "ipv6/firewall/filter": {
            "ordered": true,
            "quick": "chain",
            "category": "chain",
            "columns": ["action", "chain", "src-address", "dst-address", "protocol", "src-port", "dst-port", "port", "in-interface", "out-interface", "in-interface-list", "out-interface-list", "bytes", "packets"],
            "readonly": ["bytes", "packets", "dynamic", "invalid"],
            "form": "rule",
            "defaults": { "action": "accept", "log": "false" },
            "actions": [
                { "title": "Reset Counters", "command": "reset-counters", "selection": true },
                { "title": "Reset All Counters", "command": "reset-counters-all" }
            ]
        },
        "ipv6/firewall/nat": {
            "ordered": true,
            "element": "NAT Rule",
            "quick": "chain",
            "category": "chain",
            "columns": ["action", "chain", "src-address", "dst-address", "protocol", "src-port", "dst-port", "port", "in-interface", "out-interface", "in-interface-list", "out-interface-list", "to-address", "to-ports", "bytes", "packets"],
            "readonly": ["bytes", "packets", "dynamic", "invalid"],
            "form": "rule",
            "defaults": { "action": "accept", "log": "false" },
            "actions": [
                { "title": "Reset Counters", "command": "reset-counters", "selection": true },
                { "title": "Reset All Counters", "command": "reset-counters-all" }
            ]
        },
        "ipv6/firewall/mangle": {
            "ordered": true,
            "element": "Mangle Rule",
            "quick": "chain",
            "category": "chain",
            "columns": ["action", "chain", "src-address", "dst-address", "protocol", "src-port", "dst-port", "port", "in-interface", "out-interface", "in-interface-list", "out-interface-list", "new-packet-mark", "new-connection-mark", "new-routing-mark", "bytes", "packets"],
            "readonly": ["bytes", "packets", "dynamic", "invalid"],
            "form": "rule",
            "defaults": { "action": "accept", "log": "false" },
            "actions": [
                { "title": "Reset Counters", "command": "reset-counters", "selection": true },
                { "title": "Reset All Counters", "command": "reset-counters-all" }
            ]
        },
        "ipv6/firewall/raw": {
            "ordered": true,
            "element": "Raw Rule",
            "quick": "chain",
            "category": "chain",
            "columns": ["action", "chain", "src-address", "dst-address", "protocol", "src-port", "dst-port", "port", "in-interface", "out-interface", "in-interface-list", "out-interface-list", "bytes", "packets"],
            "readonly": ["bytes", "packets", "dynamic", "invalid"],
            "form": "rule",
            "defaults": { "action": "accept", "log": "false" },
            "actions": [
                { "title": "Reset Counters", "command": "reset-counters", "selection": true },
                { "title": "Reset All Counters", "command": "reset-counters-all" }
            ]
        },
        "ipv6/firewall/connection": {
            "columns": ["src-address", "src-port", "dst-address", "dst-port", "protocol", "connection-type", "timeout", "tcp-state", "orig-rate", "repl-rate", "orig-packets", "repl-packets", "orig-bytes", "repl-bytes"],
            "bits": ["orig-rate", "repl-rate"],
            "readonly": [
                "src-address", "src-port", "dst-address", "dst-port", "protocol", "connection-type", "timeout", "tcp-state", "orig-rate",
                "repl-rate", "orig-packets", "repl-packets", "orig-bytes", "repl-bytes", "reply-src-address", "reply-src-port",
                "reply-dst-address", "reply-dst-port", "assured", "confirmed", "dying", "seen-reply", "srcnat", "dstnat"
            ]
        },
        "ipv6/firewall/address-list": {
            "columns": ["list", "address", "timeout", "creation-time"],
            "readonly": ["creation-time"],
            "form": "address-list"
        }
    },
    "forms": {
        "rule": {
            "title": "Firewall Rule <{src-address}:{src-port}->{dst-address}:{dst-port}>",
            "tabs": [
                {
                    "title": "General",
                    "fields": [
                        "chain", "src-address", "dst-address", "src-address-list", "dst-address-list", "-",
                        "protocol", "src-port", "dst-port", "port", "in-interface", "out-interface", "-",
                        "in-interface-list", "out-interface-list", "-",
                        "packet-mark", "connection-mark", "routing-mark", "-",
                        "connection-type", "connection-state", "connection-nat-state"
                    ]
                },
                {
                    "title": "Advanced",
                    "fields": [
                        "content", "connection-bytes", "connection-rate", "per-connection-classifier", "src-mac-address", "-",
                        "out-bridge-port", "in-bridge-port", "-",
                        "in-bridge-port-list", "out-bridge-port-list", "-",
                        "ipsec-policy", "tls-host", "-",
                        "ingress-priority", "priority", "dscp", "tcp-mss", "tos", "packet-size", "random", "tcp-flags", "icmp-options"
                    ]
                },
                {
                    "title": "Extra",
                    "fields": ["nth", "connection-limit", "src-address-type", "dst-address-type", "limit", "dst-limit", "time", "headers", "-", "hop-limit"]
                },
                {
                    "title": "Action",
                    "fields": [
                        "action", "-",
                        "log", "log-prefix", "-",
                        "jump-target", "reject-with", "address-list", "address-list-timeout", "to-address", "to-ports", "src-prefix", "dst-prefix",
                        "new-packet-mark", "new-connection-mark", "new-routing-mark", "new-dscp", "new-mss", "new-priority", "new-hop-limit",
                        "sniff-target", "sniff-target-port", "sniff-id", "passthrough"
                    ]
                },
                { "title": "Statistics", "readonly": true, "fields": ["bytes", "packets"] }
            ],
            "only": [
                {
                    "fields": ["src-port", "dst-port", "port"],
                    "where": { "protocol": ["tcp", "udp", "udp-lite", "dccp", "sctp", "6", "17", "136", "33", "132"] }
                },
                { "fields": ["tcp-flags", "tcp-mss", "tls-host"], "where": { "protocol": ["tcp", "6"] } },
                { "fields": ["icmp-options"], "where": { "protocol": ["icmpv6", "58"] } },
                { "fields": ["to-ports"], "where": { "protocol": ["tcp", "udp", "dccp", "sctp", "6", "17", "33", "132"] } },
                { "fields": ["jump-target"], "where": { "action": ["jump"] }, "hide": true },
                { "fields": ["reject-with"], "where": { "action": ["reject"] }, "hide": true },
                {
                    "fields": ["address-list", "address-list-timeout"],
                    "where": { "action": ["add-src-to-address-list", "add-dst-to-address-list"] },
                    "hide": true
                },
                { "fields": ["to-address"], "where": { "action": ["dst-nat", "src-nat", "netmap"] }, "hide": true },
                { "fields": ["to-ports"], "where": { "action": ["dst-nat", "src-nat", "netmap", "redirect", "masquerade"] }, "hide": true },
                { "fields": ["src-prefix", "dst-prefix"], "where": { "action": ["snpt", "dnpt"] }, "hide": true },
                { "fields": ["new-packet-mark"], "where": { "action": ["mark-packet"] }, "hide": true },
                { "fields": ["new-connection-mark"], "where": { "action": ["mark-connection"] }, "hide": true },
                { "fields": ["new-routing-mark"], "where": { "action": ["mark-routing"] }, "hide": true },
                { "fields": ["new-dscp"], "where": { "action": ["change-dscp"] }, "hide": true },
                { "fields": ["new-mss"], "where": { "action": ["change-mss"] }, "hide": true },
                { "fields": ["new-priority"], "where": { "action": ["set-priority"] }, "hide": true },
                { "fields": ["new-hop-limit"], "where": { "action": ["change-hop-limit"] }, "hide": true },
                { "fields": ["sniff-target", "sniff-target-port"], "where": { "action": ["sniff-tzsp", "sniff-pc"] }, "hide": true },
                { "fields": ["sniff-id"], "where": { "action": ["sniff-pc"] }, "hide": true },
                {
                    "fields": ["passthrough"],
                    "where": {
                        "action": ["change-dscp", "change-hop-limit", "change-mss", "mark-connection", "mark-packet", "mark-routing", "set-priority"]
                    },
                    "hide": true
                }
            ]
        },
        "address-list": {
            "title": "Firewall Address List <{address}>",
            "tabs": [{ "title": "General", "fields": ["list", "address", "timeout", "dynamic", "creation-time"] }]
        }
    },
    "labels": {
        "port": "Any. Port",
        "new-dscp": "New DSCP (TOS)",
        "new-mss": "New TCP MSS"
    }
}
