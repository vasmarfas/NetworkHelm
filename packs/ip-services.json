{
    "$schema": "./pack.schema.json",
    "menu": ["IP", "Services"],
    "window": {
        "title": "Services",
        "tabs": [
            { "title": "Services", "path": "ip/service" }
        ]
    },
    "paths": {
        "ip/service": {
            "columns": ["name", "port", "available-from", "vrf", "certificate", "tls-version", "max-sessions"],
            "readonly": ["name", "invalid", "dynamic"],
            "sort": "name",
            "form": "service"
        }
    },
    "forms": {
        "service": {
            "title": "IP Service <{name}>",
            "renamed": { "address": "available-from" },
            "only": [{ "fields": ["certificate", "tls-version"], "where": { "name": ["api-ssl", "www-ssl"] }, "hide": true }],
            "tabs": [
                {
                    "title": "General",
                    "fields": ["name", "port", "available-from", "vrf", "certificate", "tls-version", "max-sessions"]
                }
            ]
        }
    },
    "labels": {
        "tls-version": "TLS Version"
    }
}
